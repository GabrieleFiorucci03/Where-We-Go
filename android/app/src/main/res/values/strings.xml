    <!-- ==================== Informazioni e licenze ====================
         Sezione delicata: sono gli obblighi di attribuzione delle fonti, non
         testo di contorno. Una traduzione che cambia il senso di «accesso al
         database derivato» cambia cio' che l\'app dichiara di fare. -->
    <string name="about_title">About and licences</string>
    <string name="about_intro">An offline globe for marking the countries, regions and cities you have been to. This page collects the attributions the sources require.</string>

    <string name="about_geo_section">Geographic data</string>
    <string name="about_geo_boundaries">Regional subdivisions: geoBoundaries gbOpen (198 countries or territories), with the level chosen country by country. The data has been simplified, renamed and turned into PMTiles tiles. geoBoundaries requires attribution; the national sources declared in the metadata keep their own licence: 82 ODbL datasets and 14 CC BY-SA.</string>
    <string name="about_geo_boundaries_link">geoBoundaries — licence and citation</string>
    <string name="about_geo_share">For ODbL and CC BY-SA, commercial redistribution is permitted, but attribution, a link to the licence, an indication of the changes made, and access to a copy of the derived database or to the machine-readable method behind it all remain required.</string>
    <string name="about_geo_odbl_link">ODbL 1.0 text</string>
    <string name="about_geo_ccbysa_link">CC BY-SA 4.0 text</string>
    <string name="about_geo_derived">Access to the derived database is satisfied by publishing the data the app actually uses: one file per country, each with its own source, its own licence, the URL of the original and the list of changes applied. The scripts that produce them are in the repository.</string>
    <string name="about_geo_derived_link">Derived data — archive, manifest and SHA-256</string>
    <string name="about_geo_naturalearth">Reference national borders and 14 regional fallbacks: Natural Earth, public domain. The outlines of countries that have regions available are derived from the union of those regions and keep the provenance and licence of the relevant source, as stated in the derived data package.</string>
    <string name="about_geo_naturalearth_link">Natural Earth — terms of use</string>

    <string name="about_cities_section">Cities and names</string>
    <string name="about_cities">The city index comes from GeoNames allCountries. It is distributed under a Creative Commons Attribution licence: the attribution to GeoNames is preserved on this page. City names are shown in the international form GeoNames publishes; the search also accepts local and alternative names.</string>
    <string name="about_cities_link">GeoNames — terms and attribution</string>

    <string name="about_libs_section">Libraries and bundled resources</string>
    <string name="about_libs_intro">The project code is MIT. The third-party resources included are:</string>
    <string name="about_libs_maplibre">MapLibre GL JS — BSD-3-Clause (MapLibre contributors and the components named in the licence text).</string>
    <string name="about_libs_pmtiles">pmtiles.js — BSD-3-Clause (Protomaps; the PMTiles specification is public domain/CC0 where applicable).</string>
    <string name="about_libs_flags">flag-icons — MIT, copyright Panayiotis Lipiridis.</string>
    <string name="about_libs_noto">Noto Sans glyphs — SIL Open Font License 1.1.</string>
    <string name="about_libs_android">Compose, AndroidX, WebKit, Browser, Kotlin Coroutines and Coil — Apache License 2.0, or the licences declared by the respective artifacts.</string>
    <string name="about_libs_texts">The full licence texts for the JavaScript, the flags and the fonts are included in the app assets. Detailed attributions for each regional source are published in the project repository.</string>
    <string name="about_libs_repo_link">Repository and full attributions</string>
    <string name="about_libs_maplibre_link">MapLibre GL JS — licence</string>
    <string name="about_libs_pmtiles_link">Protomaps PMTiles — licence</string>
    <string name="about_libs_flags_link">flag-icons — licence</string>
    <string name="about_libs_noto_link">Noto Sans — SIL OFL</string>

    <string name="about_photos_section">Photographs</string>
    <string name="about_photos">The gallery uses Wikimedia Commons only when you open it. The photos are not bundled in the app: for each result the author and licence are shown, and tapping opens the original page on Commons. Requirements may vary from file to file.</string>
    <string name="about_photos_link">Commons — reusing content</string>

    <string name="about_privacy_section">Privacy and network</string>
    <string name="about_privacy">Countries, regions, cities and preferences stay on the device. The app requires no account, and carries no advertising or analytics. The network is used only for the Wikimedia Commons gallery and for the browser when you choose to look something up; Wikimedia receives the HTTP request and the IP address according to its own policies.</string>
    <string name="about_privacy_link">Wikimedia — privacy policy</string>

    <string name="about_disputed">Disputed borders: the map shows what each country\'s source declares, and the sources do not agree with one another. Where they contradict each other — Kashmir, Crimea, Cyprus, Taiwan, Palestine, Western Sahara — Where We Go does not choose and does not intend to take a position.</string>
    <string name="about_accuracy">Accuracy: the geographic data is provided as made available by the sources; Where We Go does not guarantee the completeness or precision of the borders.</string>
</resources>
